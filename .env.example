# ── Slack ──────────────────────────────────────────────────────────────────
# Bot User OAuth Token (starts with xoxb-).
#   Slack app  →  OAuth & Permissions  →  Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token (starts with xapp-) WITH the connections:write scope.
#   Slack app  →  Basic Information  →  App-Level Tokens. Required for Socket Mode.
SLACK_APP_TOKEN=xapp-your-app-token

# ── Uptime Kuma ──────────────────────────────────────────────────────────────
KUMA_URL=https://uptime.kuma.url
KUMA_USERNAME=your-kuma-username
KUMA_PASSWORD=your-kuma-password
# Only if the Kuma account has 2FA enabled: put the TOTP *secret* here (the
# string behind the QR code), NOT a 6-digit code. Leave blank otherwise.
KUMA_MFA_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# In Docker this lives on a named volume. For a bare-metal run, set it to a
# local path such as: uptimebot.db
DB_PATH=/data/uptimebot.db

# ── Behaviour (optional; sensible defaults shown) ────────────────────────────
CLIENT_TTL_DAYS=7          # how long client sites live before auto-removal
MONITOR_INTERVAL=60        # Kuma check interval per monitor, seconds
MONITOR_RETRIES=2          # retries before Kuma marks a monitor down
STATUS_POLL_SECONDS=120    # how often the bot checks for up/down changes
EXPIRY_POLL_SECONDS=3600   # how often the bot sweeps for expiring client sites
EXPIRY_WARN_HOURS=24       # warn this many hours before a client site expires

# ── Access control (optional). Comma-separated Slack IDs. Empty = allow all ──
# e.g. ALLOWED_USER_IDS=U012ABC,U034DEF
ALLOWED_USER_IDS=
ALLOWED_CHANNEL_IDS=
